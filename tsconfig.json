{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    // A cozinha importa o pacote pelo nome, mas lê o código-fonte (o mesmo alias do Vite).
    "paths": {
      "@deckdoo/design": ["./src/index.ts"]
    }
  },
  "include": ["src", "playground", "tsup.config.ts"]
}
