{
  "name": "@deckdoo/design",
  "version": "0.9.0",
  "description": "O padrão visual da suíte DeckDoo: tema Mantine, tokens CSS, peças e marca.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "repository": "github:useAnder/deckdoo-design",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "deckdoo-favicon": "scripts/favicon.mjs"
  },
  "files": [
    "dist",
    "scripts/favicon.mjs",
    "src/brand"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "favicon": "node scripts/favicon.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@phosphor-icons/react": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
